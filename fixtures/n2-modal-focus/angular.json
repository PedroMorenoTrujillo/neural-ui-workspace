{
  "version": 1,
  "projects": {
    "modal-focus-consumer": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist",
            "index": "src/index.html",
            "styles": ["src/styles.css"],
            "optimization": false,
            "sourceMap": true
          }
        }
      }
    }
  }
}
