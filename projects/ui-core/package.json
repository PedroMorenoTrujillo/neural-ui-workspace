{
  "name": "@neural-ui/core",
  "version": "2.0.3",
  "description": "Modern Angular UI component library built with signals, standalone components, and OnPush change detection.",
  "author": "Pedro Moreno Trujillo",
  "keywords": [
    "angular",
    "ui",
    "components",
    "signals",
    "design-system",
    "standalone",
    "zoneless"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@angular-devkit/schematics": ">=22.0.0 <23.0.0",
    "@angular/cdk": ">=22.0.0 <23.0.0",
    "@angular/common": ">=22.0.0 <23.0.0",
    "@angular/core": ">=22.0.0 <23.0.0",
    "@angular/forms": ">=22.0.0 <23.0.0",
    "@angular/router": ">=22.0.0 <23.0.0",
    "@schematics/angular": ">=22.0.0 <23.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "./styles/*.scss",
    "./styles.scss"
  ],
  "schematics": "./schematics/collection.json",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroMorenoTrujillo/neural-ui-workspace.git",
    "directory": "projects/ui-core"
  },
  "homepage": "https://ui.neuralui.org/v2/",
  "bugs": {
    "url": "https://github.com/PedroMorenoTrujillo/neural-ui-workspace/issues"
  },
  "exports": {
    "./token-manifest.json": "./token-manifest.json",
    "./styles": {
      "sass": "./styles.scss",
      "style": "./styles.scss",
      "default": "./styles.scss"
    },
    "./styles/*": {
      "sass": "./styles/*",
      "style": "./styles/*",
      "default": "./styles/*"
    }
  },
  "sass": "./styles.scss",
  "style": "./styles.scss"
}
