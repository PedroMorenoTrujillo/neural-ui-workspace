{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/neural-ui/core",
  "deleteDestPath": false,
  "allowedNonPeerDependencies": ["chart.js"],
  "lib": {
    "entryFile": "public-api.ts"
  },
  "assets": [
    "./README.md",
    "./styles.scss",
    {
      "input": "./schematics",
      "glob": "**",
      "output": "./schematics"
    },
    {
      "input": "./styles",
      "glob": "**",
      "output": "./styles"
    }
  ]
}
