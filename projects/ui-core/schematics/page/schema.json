{
  "$schema": "http://json-schema.org/schema",
  "$id": "NeuralUiPage",
  "title": "Neural UI page generator options",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Page name.", "$default": { "$source": "argv", "index": 0 } },
    "project": { "type": "string", "description": "Angular application project." },
    "path": { "type": "string", "description": "Output directory." },
    "force": { "type": "boolean", "default": false }
  },
  "required": ["name"],
  "additionalProperties": false
}
