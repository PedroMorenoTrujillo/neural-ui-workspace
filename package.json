{
  "name": "neural-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "node scripts/build-ui-core.mjs",
    "build:watch": "node scripts/build-ui-core.mjs --watch",
    "figma:sync": "node scripts/figma-export.mjs",
    "audit:primitives": "node scripts/audit-ui-core-primitives.mjs",
    "audit:entrypoints": "node scripts/audit-ui-core-entrypoints.mjs",
    "audit:cva": "node scripts/audit-ui-core-cva-contracts.mjs",
    "audit:bundle": "node scripts/audit-ui-core-bundle.mjs",
    "audit:table-architecture": "node scripts/audit-table-architecture.mjs",
    "audit:h5b3-option-family": "node scripts/generate-h5b3-option-family-audit.mjs",
    "audit:h5c2-boundaries": "node scripts/audit-h5c2-package-private-boundaries.mjs && node scripts/generate-h5c2-package-private-dependency-graph.mjs",
    "audit:h5c2-duplication": "node scripts/audit-h5c2-source-duplication.mjs",
    "audit:logical-css": "node scripts/audit-ui-core-logical-css.mjs",
    "tokens:generate": "node scripts/generate-token-manifest.mjs",
    "audit:tokens": "node scripts/audit-token-contract.mjs",
    "snapshot:contracts": "node scripts/audit-public-contract.mjs --update",
    "audit:contracts": "node scripts/audit-public-contract.mjs",
    "test:contracts": "node --test scripts/public-contract.spec.mjs",
    "docs:sync": "node scripts/sync-readme-metrics.mjs --update",
    "audit:docs": "node scripts/sync-readme-metrics.mjs",
    "audit:package": "node scripts/audit-published-package.mjs",
    "verify:package": "node scripts/verify-ui-core-package.mjs",
    "prepare:release-artifacts": "node scripts/prepare-release-artifacts.mjs",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "test:release-artifacts": "node --test scripts/release-artifacts.spec.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:compat": "node scripts/test-ui-core-compatibility.mjs",
    "test:compat:matrix": "node scripts/test-ui-core-compatibility-matrix.mjs",
    "test:angular-compatibility": "node --test scripts/angular-compatibility.spec.mjs",
    "test:schematics": "node scripts/test-ui-core-schematics.mjs",
    "test:imports": "node scripts/test-ui-core-entrypoint-imports.mjs",
    "test:ssr-smoke": "node scripts/test-ui-core-ssr-smoke.mjs",
    "test:option-api-template-types": "node scripts/test-option-api-template-types.mjs",
    "test:h5b4-template-types": "node scripts/test-h5b4-template-types.mjs",
    "test:h5c1-facade": "node scripts/test-h5c1-public-facade.mjs",
    "test:h5c2-boundaries": "node scripts/test-h5c2-package-private-boundaries.mjs",
    "test:table-body-section-template-types": "node scripts/test-table-body-section-template-types.mjs",
    "test": "ng test ui-core --watch=false",
    "test:coverage": "ng test ui-core --watch=false --coverage",
    "check:coverage:components": "node scripts/check-component-coverage.mjs",
    "test:coverage:components": "npm run test:coverage && npm run check:coverage:components",
    "test:stress:sidebar": "ng test ui-core --watch=false --no-coverage --include=sidebar/neu-sidebar.component.stress.spec.ts --runner-config=vitest.stress.config.mts",
    "sandbox": "ng serve sandbox --open"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "overrides": {
    "esbuild": "0.27.3",
    "piscina": "5.2.0",
    "undici": "7.28.0",
    "vite": "7.3.5"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/platform-browser": "21.2.19",
    "@angular/router": "21.2.19",
    "@ng-icons/core": "^33.2.0",
    "@ng-icons/lucide": "^33.2.0",
    "apexcharts": "^5.10.4",
    "ng-apexcharts": "^2.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.19",
    "@angular-devkit/schematics": "21.2.19",
    "@schematics/angular": "21.2.19",
    "@vitest/coverage-v8": "^4.1.3",
    "jsdom": "^28.0.0",
    "ng-packagr": "21.2.7",
    "prettier": "^3.8.1",
    "publint": "^0.3.16",
    "@arethetypeswrong/cli": "^0.18.2",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
