{
  "name": "neural-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "node scripts/build-ui-core.mjs",
    "build:watch": "node scripts/build-ui-core.mjs --watch",
    "figma:sync": "node scripts/figma-export.mjs",
    "audit:primitives": "node scripts/audit-ui-core-primitives.mjs",
    "audit:entrypoints": "node scripts/audit-ui-core-entrypoints.mjs",
    "audit:entrypoint-coverage": "node scripts/audit-entrypoint-coverage.mjs",
    "quality:matrix": "node scripts/audit-quality-matrix.mjs --update",
    "audit:quality-matrix": "node scripts/audit-quality-matrix.mjs",
    "audit:quality-matrix:strict": "node scripts/audit-quality-matrix.mjs --strict",
    "audit:manual-at-evidence": "node scripts/audit-manual-at-evidence.mjs",
    "audit:cva": "node scripts/audit-ui-core-cva-contracts.mjs",
    "audit:bundle": "node scripts/audit-ui-core-bundle.mjs",
    "size-limit": "npm run build && npm run size-limit:built",
    "size-limit:built": "node scripts/audit-size-limit.mjs",
    "performance:sync": "node scripts/sync-performance-evidence.mjs --update",
    "audit:performance": "node scripts/sync-performance-evidence.mjs",
    "showcase:sync": "node scripts/sync-showcase-evidence.mjs",
    "audit:showcase-evidence": "node scripts/sync-showcase-evidence.mjs",
    "audit:logical-css": "node scripts/audit-ui-core-logical-css.mjs",
    "audit:governance": "node scripts/audit-governance.mjs",
    "audit:licenses": "node scripts/audit-production-licenses.mjs",
    "audit:security": "npm audit --audit-level=low",
    "snapshot:contracts": "node scripts/audit-public-contract.mjs --update",
    "audit:contracts": "node scripts/audit-public-contract.mjs",
    "docs:sync": "node scripts/sync-readme-metrics.mjs --update",
    "audit:docs": "node scripts/sync-readme-metrics.mjs",
    "audit:package": "node scripts/audit-published-package.mjs",
    "verify:package": "node scripts/verify-ui-core-package.mjs",
    "verify:release:automated": "node scripts/verify-release.mjs --automated-only",
    "verify:release": "node scripts/verify-release.mjs",
    "test:compat": "node scripts/test-ui-core-compatibility.mjs",
    "test:compat:matrix": "node scripts/test-ui-core-compatibility-matrix.mjs",
    "test:schematics": "node scripts/test-ui-core-schematics.mjs",
    "test:imports": "node scripts/test-ui-core-entrypoint-imports.mjs",
    "test:ssr-smoke": "node scripts/test-ui-core-ssr-smoke.mjs",
    "test": "ng test ui-core --watch=false",
    "test:coverage": "ng test ui-core --watch=false --coverage",
    "sandbox": "ng serve sandbox --open"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "overrides": {
    "esbuild": "0.28.2",
    "piscina": "5.2.0",
    "undici": "7.29.0",
    "vite": "7.3.5"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.20",
    "@angular/compiler": "21.2.20",
    "@angular/core": "21.2.20",
    "@angular/forms": "21.2.20",
    "@angular/platform-browser": "21.2.20",
    "@angular/router": "21.2.20",
    "@ng-icons/core": "^33.2.0",
    "@ng-icons/lucide": "^33.2.0",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "21.2.21",
    "@angular/build": "21.2.21",
    "@angular/cli": "21.2.21",
    "@angular/compiler-cli": "21.2.20",
    "@arethetypeswrong/cli": "^0.18.2",
    "@schematics/angular": "21.2.21",
    "@size-limit/file": "^13.0.3",
    "@vitest/coverage-v8": "^4.1.3",
    "jsdom": "^28.0.0",
    "ng-packagr": "21.2.7",
    "prettier": "^3.8.1",
    "publint": "^0.3.16",
    "size-limit": "^13.0.3",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
